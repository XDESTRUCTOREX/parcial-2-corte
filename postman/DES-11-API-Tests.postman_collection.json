      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type es application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Respuesta tiene estructura válida de health check', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.message).to.eql('Servidor de Inventario activo');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "02 - Crear Producto Exitoso (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Content-Type es application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Contrato de respuesta y datos del producto creado', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data).to.be.an('object');",
              "    pm.expect(json.data._id).to.be.a('string');",
              "    pm.expect(json.data.name).to.eql('Teclado Mecánico RGB');",
              "    pm.expect(json.data.category).to.eql(pm.collectionVariables.get('productCategory') || 'Periféricos');",
              "    pm.expect(json.data.price).to.eql(250000);",
              "    pm.expect(json.data.stock).to.eql(15);",
              "    pm.expect(json.data.createdAt).to.be.a('string');",
              "    pm.expect(json.data.updatedAt).to.be.a('string');",
              "",
              "    // Guardar ID en variables de colección y entorno para peticiones siguientes",
              "    pm.collectionVariables.set('created_product_id', json.data._id);",
              "    pm.environment.set('created_product_id', json.data._id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado Mecánico RGB\",\n  \"category\": \"{{productCategory}}\",\n  \"price\": 250000,\n  \"stock\": 15\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      }
    },
